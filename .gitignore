# Byte-compiled
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/

# Database
*.db
*.db-journal
*.db-wal
*.db-shm

# Uploads (keep directory, ignore files)
uploads/*
!uploads/.gitkeep

# Data directory (keep directory, ignore db)
data/*
!data/.gitkeep

# Internal tooling
.superpowers/
.omc/

# Frontend build toolchain. The built output under static/app/ IS committed so
# the app runs without Node; only the toolchain and its caches are ignored.
frontend/node_modules/
frontend/.vite/
frontend/dist/

# Environment variables
.env

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
